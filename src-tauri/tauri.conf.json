{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dusk",
  "version": "0.3.2",
  "identifier": "dev.dusk.app",
  "build": {
    "beforeDevCommand": "npm run dev:vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Dusk",
        "width": 1180,
        "height": 800,
        "minWidth": 720,
        "minHeight": 560,
        "visible": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https://avatars.githubusercontent.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["client/**/*", "sunshine/**/*", "licenses/**/*"],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": ["libfuse2"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBFNkNCNzdEMzUxNzEwMDgKUldRSUVCYzFmYmRzRHVDakVjR0ZMZXJ6WjdnRmdKd3gwbkdQNENYYmc0anFDOWJXQUppQVdwTjcK",
      "endpoints": [
        "https://github.com/darkharasho/dusk/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
