# Rust / Tauri
src-tauri/target/
src-tauri/gen/

# The staged Moonlight fork. Built by its own repository and copied in by
# scripts/stage-client.sh; the README is committed so the directory exists
# even when nothing is staged, because Tauri fails on a resource path that
# does not resolve.
src-tauri/client/*
!src-tauri/client/README.md

# The staged Sunshine installer. Downloaded by scripts/stage-sunshine.sh;
# the README is committed for the same reason as the client's.
src-tauri/sunshine/*
!src-tauri/sunshine/README.md

# Written by the release workflow with the exact helper versions shipped.
src-tauri/licenses/versions.txt
